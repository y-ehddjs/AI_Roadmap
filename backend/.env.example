# cp this file to .env and fill in real values, then export before running uvicorn
# (or use `uvicorn app.main:app --reload --env-file .env` once python-dotenv is added)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=

# Web Push (see: https://web.dev/articles/push-notifications-web-push-protocol)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Origin the frontend runs on, for CORS (default already matches local dev)
FRONTEND_ORIGIN=http://localhost:3000

# Required to call POST /internal/check-coaching or /internal/send-reminders
# manually (send it back as the X-Internal-Secret header) — the scheduled
# jobs themselves run in-process and don't need it. Generate with e.g.
# `openssl rand -hex 32`.
INTERNAL_API_SECRET=
