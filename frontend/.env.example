# cp this file to .env.local and fill in real values (Task 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Task 14 — Web Push subscription (browser-side VAPID public key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Task 17 — FastAPI backend base URL (http://localhost:8000 for local dev)
NEXT_PUBLIC_BACKEND_URL=

# Server-side only (no NEXT_PUBLIC_ prefix — never reaches the browser bundle).
# Used by app/api/check-coaching to call the backend's secret-gated
# POST /internal/check-coaching on the user's behalf.
BACKEND_URL=
INTERNAL_API_SECRET=
